# pkc RPC (bitsocial-cli daemon) the bot reads and publishes through; install-bot uses it too unless --rpc is given.
# For a remote daemon: ws://host:9138/<auth-key>
PKC_RPC_URL=ws://localhost:9138
# Or reach a daemon on another machine through ssh (`ssh -N -L`, a ~/.ssh/config Host alias works).
# The daemon then sees a local connection, so no auth key is needed. PKC_RPC_URL is ignored when set.
PKC_RPC_SSH_HOST=
# where the RPC listens, as seen from that host
PKC_RPC_SSH_REMOTE=127.0.0.1:9138

# The bot's wallet-owned name; communities exempt this name from their challenges
BOT_NAME=askwise.bso
BOT_DISPLAY_NAME=AskWise

# Community where owners/admins register their community
REGISTRY_ADDRESS=

# LLM backend:
#   anthropic-api  Messages API, billed per token to ANTHROPIC_API_KEY (or an `ant auth login` profile)
#   claude-code    the local `claude` CLI (Claude Code), using the subscription it is logged in with.
#                  Run `claude` once and log in first. Check that your plan's terms allow serving a
#                  public bot; see the README.
LLM_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=
# path of the claude binary for LLM_PROVIDER=claude-code
CLAUDE_CODE_BIN=claude
# claude-haiku-5-5 is the cheapest model; e.g. claude-opus-5-5 (4 / 20 USD per MTok) for better answers
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=medium
# USD per 1M tokens, used for cost tracking
LLM_INPUT_PRICE_PER_MTOK=0.1
LLM_OUTPUT_PRICE_PER_MTOK=0.5

# Comma-separated strings a reply must never contain (e.g. your name or email). A reply containing one,
# even spelled out as "name at domain dot com", is not published. With LLM_PROVIDER=claude-code the
# logged-in account's email and org id are added automatically.
PRIVATE_STRINGS=

# Images in the thread are shown to the LLM (up to LLM_MAX_IMAGES).
# With IMAGE_PROXY_URL set (http://host:port, socks5://127.0.0.1:9050 for Tor, ...) the bot downloads
# them through the proxy; unset, it passes the URL and Anthropic fetches it. Either way the image host
# never sees the bot's IP address.
IMAGE_PROXY_URL=
LLM_MAX_IMAGES=4

# Limits
LIMIT_COMMUNITY_REPLIES_PER_HOUR=30
LIMIT_COMMUNITY_TOKENS_PER_DAY=500000
LIMIT_AUTHOR_MENTIONS_PER_HOUR=5
LIMIT_GLOBAL_USD_PER_DAY=20
LIMIT_MAX_BOT_REPLIES_IN_THREAD=3

# Backlog and retries: mentions posted while the bot was offline are answered when it comes back, oldest
# first; older than MENTION_MAX_AGE_HOURS are skipped. Failed replies retry after 1x, 2x, 4x... RETRY_BASE_SECONDS
# (up to MENTION_MAX_ATTEMPTS); rate-limited ones every 10x RETRY_BASE_SECONDS.
MENTION_MAX_AGE_HOURS=48
MENTION_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RESCAN_INTERVAL_SECONDS=60
