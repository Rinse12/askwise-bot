# pkc RPC the bot reads and publishes through (bitsocial-cli daemon)
PKC_RPC_URL=ws://localhost:9138

# The bot's wallet-owned name; communities exempt this name from their challenges
BOT_NAME=bitsocialbot.bso
BOT_DISPLAY_NAME=Bitsocial Bot

# Community where owners/admins register their community
REGISTRY_ADDRESS=

# LLM (Anthropic)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the cheapest model; e.g. claude-opus-5-5 (4 / 20 USD per MTok) for better answers
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=medium
# USD per 1M tokens, used for cost tracking
LLM_INPUT_PRICE_PER_MTOK=0.1
LLM_OUTPUT_PRICE_PER_MTOK=0.5

# Images in the thread are shown to the LLM (up to LLM_MAX_IMAGES).
# With IMAGE_PROXY_URL set (http://host:port, socks5://127.0.0.1:9050 for Tor, ...) the bot downloads
# them through the proxy; unset, it passes the URL and Anthropic fetches it. Either way the image host
# never sees the bot's IP address.
IMAGE_PROXY_URL=
LLM_MAX_IMAGES=4

# Limits
LIMIT_COMMUNITY_REPLIES_PER_HOUR=30
LIMIT_COMMUNITY_TOKENS_PER_DAY=500000
LIMIT_AUTHOR_MENTIONS_PER_HOUR=5
LIMIT_GLOBAL_USD_PER_DAY=20
LIMIT_MAX_BOT_REPLIES_IN_THREAD=3
